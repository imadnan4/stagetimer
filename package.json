{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build.js",
    "build:next": "next build",
    "start": "node scripts/start.js",
    "start:next": "node scripts/serve-static.js",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:frontend": "vitest run --project frontend",
    "server": "node server/server.js",
    "dev:all": "concurrently \"npm run server\" \"next dev --turbopack\"",
    "dev:all:bun": "concurrently \"bun run server\" \"bun run dev\""
  },
  "dependencies": {
    "@railway/cli": "^4.61.1",
    "@zxing/browser": "^0.1.5",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "next": "^15.5.14",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.14",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
