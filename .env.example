# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# Production values live in the Netlify (frontend) and Heroku (backend)
# dashboards, not in the repository.
# ---------------------------------------------------------------------------

# Frontend variables (Netlify, Production context). Safe to expose — they are
# inlined into the public bundle at build time.
NEXT_PUBLIC_API_URL=https://your-backend.herokuapp.com
NEXT_PUBLIC_WS_URL=wss://your-backend.herokuapp.com/ws
# Neon Auth (Managed Better Auth) base URL for this branch.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth

# Backend variables (Heroku). SECRETS — server-side only.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-site.netlify.app
CORS_ALLOW_ALL=0
SESSION_TTL_MINUTES=120
SESSION_CODE_ALPHABET=23456789ABCDEFGHJKMNPQRSTUVWXYZ

# Neon Postgres (pooled connection string) and Managed Better Auth.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Free-tier metering.
FREE_ROOM_LIMIT=5
USAGE_HASH_SALT=change-me-to-a-long-random-string

# Polar (payments).
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=replace-with-polar-org-access-token
POLAR_PRODUCT_ID=replace-with-one-time-product-id
POLAR_ORGANIZATION_ID=replace-with-polar-organization-id
POLAR_WEBHOOK_SECRET=replace-with-polar-webhook-signing-secret

# Local fallback for backend port.
PORT=8787
